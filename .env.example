# =============================================================================
# Memory Benchmarks — Environment Configuration
# =============================================================================
# Copy to .env and fill in your values:  cp .env.example .env
# Values in .env override variables already exported in your shell.

# ---------------------------------------------------------------------------
# Required: LLM Provider (for answer generation and judging)
# ---------------------------------------------------------------------------
# With the OSS backend, this key is also used by the Mem0 server for
# memory extraction and embeddings (see docker-compose.yml).
OPENAI_API_KEY=your_openai_api_key

# Optional: OpenAI-compatible endpoint for answer/judge models.
# Leave unset to use OpenAI. Set it to use any OpenAI-compatible provider
# (DeepSeek, vLLM, OpenRouter, ...); OPENAI_API_KEY must then be that
# provider's key. Read directly by the openai SDK.
# OPENAI_BASE_URL=https://api.deepseek.com

# Optional: Other LLM providers (select with --provider anthropic|azure)
# ANTHROPIC_API_KEY=your_anthropic_api_key
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# ---------------------------------------------------------------------------
# Optional: Default answerer / judge models
# ---------------------------------------------------------------------------
# Used by all benchmarks when --answerer-model / --judge-model are not passed.
# Defaults to gpt-5 if unset. Must be a model name your provider accepts.
# ANSWERER_MODEL=gpt-5
# JUDGE_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Mem0 Backend — choose ONE of the two blocks below
# ---------------------------------------------------------------------------

# --- Option A: OSS Server (default) ---
# Start with: docker compose up -d
# The server runs at http://localhost:8888 by default.
MEM0_BACKEND=oss
MEM0_HOST=http://localhost:8888

# Server model config (read by docker-compose, not by the benchmark scripts)
# LLM_MODEL=gpt-4o-mini
# EMBEDDER_MODEL=text-embedding-3-small

# --- Option B: Mem0 Cloud ---
# To use Mem0 Cloud instead, comment out the two Option A lines above
# and uncomment these. No Docker needed.
# MEM0_BACKEND=cloud
# MEM0_HOST=https://api.mem0.ai
# MEM0_API_KEY=your_mem0_api_key
# MEM0_ORGANIZATION_ID=your_org_id   # optional
# MEM0_PROJECT_ID=your_project_id    # optional
